{
  "name": "@mafesoftware/outbox",
  "version": "0.1.0",
  "description": "Outbox transaccional para correo y WhatsApp: la app encola un mensaje en la MISMA transacción que el hecho de negocio (encolar, exige transacción) y un cron lo procesa con reintentos, backoff con jitter y FOR UPDATE SKIP LOCKED (procesarOutbox). decidir/backoff/clasificarResultado en el núcleo; tablaOutbox + encolar + procesarOutbox en /drizzle; transporteCorreo/transporteWhatsApp adaptan @mafesoftware/correo y @mafesoftware/kapso-wa sin depender de ellos en tiempo de ejecución.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "sql"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/outbox"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45 <0.46"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@mafesoftware/tenant": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "~0.31",
    "drizzle-orm": "~0.45.2",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "outbox",
    "correo",
    "whatsapp",
    "multi-tenant",
    "drizzle"
  ]
}
