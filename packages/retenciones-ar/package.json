{
  "name": "@mafesoftware/retenciones-ar",
  "version": "0.1.0",
  "description": "Retenciones impositivas argentinas: Ganancias (RG 830, minimo no sujeto acumulado o escala), IVA, SUSS y IIBB (padron ARBA/AGIP o Convenio Multilateral), exclusiones/certificados de no retencion y el formateo de ancho fijo/delimitado que usan las exportaciones SICORE/SIRE/ARBA/AGIP. Nucleo puro: sin DB, sin framework, plata en centavos bigint, cantidades como string decimal. /drizzle (peerDependency opcional drizzle-orm) trae tablaPadronIibb y tablaExclusiones.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js",
      "default": "./dist/drizzle/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/retenciones-ar"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45 <0.46"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@mafesoftware/plata-ar": "workspace:^",
    "@mafesoftware/tenant": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "~0.31",
    "drizzle-orm": "~0.45.2",
    "fast-check": "^4.10.2",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "retenciones",
    "percepciones",
    "ganancias",
    "iva",
    "suss",
    "iibb",
    "sicore",
    "sire",
    "arba",
    "agip",
    "argentina"
  ],
  "sideEffects": false
}
