{
  "name": "@mafesoftware/mercadopago-ar",
  "version": "0.1.0",
  "description": "Integracion de Mercado Pago para Argentina: Checkout Pro, OAuth de marketplace y webhooks. Sin dependencias, sin ORM, sin framework.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mercadopago",
    "checkout-pro",
    "argentina",
    "webhooks",
    "oauth",
    "marketplace"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/mercadopago-ar"
  }
}
