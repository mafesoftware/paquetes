{
  "name": "@mafesoftware/mercadopago-ar",
  "version": "0.1.0",
  "description": "Integracion de Mercado Pago para Argentina: Checkout Pro, OAuth de marketplace y webhooks. Sin dependencias, sin ORM, sin framework.",
  "license": "MIT",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./next": { "types": "./dist/next/index.d.ts", "default": "./dist/next/index.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=20" },
  "keywords": ["mercadopago", "checkout-pro", "argentina", "webhooks", "oauth", "marketplace"],
  "publishConfig": { "access": "public" }
}
