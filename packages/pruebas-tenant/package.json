{
  "name": "@mafesoftware/pruebas-tenant",
  "version": "0.1.1",
  "description": "Harness de aislamiento entre tenants: probarAislamiento(...) corre un registro de casos como tenant B contra un id de A y clasifica el resultado (o la excepción) como \"no encontrado\" o fuga. Núcleo puro; describeAislamiento (subpath /vitest, vitest como peerDependency opcional) registra un it() por caso.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vitest": {
      "types": "./dist/vitest/index.d.ts",
      "import": "./dist/vitest/index.js",
      "default": "./dist/vitest/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/pruebas-tenant"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "peerDependencies": {
    "vitest": ">=5"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tenant",
    "multi-tenant",
    "aislamiento",
    "vitest",
    "devkit"
  ]
}
