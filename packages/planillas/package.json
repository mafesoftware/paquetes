{
  "name": "@mafesoftware/planillas",
  "version": "0.2.0",
  "description": "Motor genérico de importación de planillas .xlsx (mapeo de columnas desordenadas, validación fila por fila, idempotencia por clave natural) y exportación .csv/.xlsx (BOM, separador ';', anti-inyección de fórmulas) para los productos de MAFE Software.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "sql"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/planillas"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "keywords": [
    "importar",
    "exportar",
    "csv",
    "xlsx",
    "planillas",
    "excel"
  ]
}
