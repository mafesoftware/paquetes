{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Sin "rootDir" a propósito, mismo criterio que packages/indices-ar/tsconfig.json:
    // este paquete depende en tiempo de ejecución de otro paquete del monorepo
    // (@mafesoftware/plata-ar), resuelto por el "paths" de ../../tsconfig.base.json
    // contra su CÓDIGO FUENTE (no contra dist, que en el paso de typecheck de CI
    // todavía no existe). Con "rootDir": "src" (como tsconfig.build.json) TS
    // rechazaría esos archivos fuera de packages/proveedores/src con TS6059,
    // aunque no vaya a emitir nada.
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
