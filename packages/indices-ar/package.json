{
  "name": "@mafesoftware/indices-ar",
  "version": "0.1.2",
  "description": "Indices de ajuste argentinos (CAC, ICC, UVA, CER, IPC, ICL): factores de ajuste, periodo de referencia, modalidades disponible/provisorio/definitivo, topes, polinomicas, puntos-indice y, en /drizzle y /fuentes, tablas y lectores de fuentes publicas (BCRA, dolarapi) con fetch inyectado.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./drizzle": {
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js",
      "default": "./dist/drizzle/index.js"
    },
    "./fuentes": {
      "types": "./dist/fuentes/index.d.ts",
      "import": "./dist/fuentes/index.js",
      "default": "./dist/fuentes/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "sql"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mafesoftware/paquetes.git",
    "directory": "packages/indices-ar"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45 <0.46"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "dependencies": {
    "@mafesoftware/plata-ar": "workspace:^",
    "@mafesoftware/fechas-ar": "workspace:^"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "drizzle-kit": "~0.31",
    "drizzle-orm": "~0.45.2",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "indices",
    "ajustes",
    "cac",
    "icc",
    "uva",
    "cer",
    "ipc",
    "icl",
    "argentina"
  ],
  "sideEffects": false
}
